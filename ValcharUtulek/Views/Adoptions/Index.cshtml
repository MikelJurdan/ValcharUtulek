@model IEnumerable<ValcharUtulek.Domain.Entities.Animal>

@{
    ViewData["Title"] = "Adoptions";
}

@section Scripts {
    <script>
        var adoptionModal = document.getElementById('adoptionModal');
        adoptionModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var animalId = button.getAttribute('data-animal-id');
            var animalName = button.getAttribute('data-animal-name');

            var modalTitle = adoptionModal.querySelector('.modal-title');
            var animalIdInput = adoptionModal.querySelector('#animalId');

            modalTitle.textContent = 'Adoptovat ' + animalName;
            animalIdInput.value = animalId;
        });
    </script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/adoptions/index.css" asp-append-version="true" />
}

<h1>Virtuální Adopce</h1>
@if (User.IsInRole(ValcharUtulek.Domain.Entities.Role.Admin.ToString()))
{
    <p>
        <a asp-action="Create" class="btn btn-primary-custom">Vytvořit adopci</a>
    </p>
}
<div class="row">
    @foreach (var animal in Model)
    {
        <div class="col-md-3 mb-3">
            <div class="card" style="width: 18rem;">
                <img src="~/images/@(animal.Photo ?? "default.png")" class="card-img-top" alt="@animal.Name">
                <div class="card-body">
                    <h5 class="card-title">@animal.Name</h5>
                    <p class="card-text">
                        Věk: @animal.Age<br />
                        Druh: @animal.Species<br />
                        Pohlaví: @animal.Gender
                    </p>
                    <button type="button" class="btn btn-primary-custom" data-bs-toggle="modal" data-bs-target="#adoptionModal" data-animal-id="@animal.AnimalId" data-animal-name="@animal.Name">
                        Adopce
                    </button>
                    @if (User.IsInRole(ValcharUtulek.Domain.Entities.Role.Admin.ToString()))
                    {
                        <a asp-controller="Animals" asp-action="Delete" asp-route-id="@animal.AnimalId" class="nav-link text-danger" style="display:inline;">Odstranit zvíře</a><br />
                        <a asp-controller="Animals" asp-action="Edit" asp-route-id="@animal.AnimalId" class="nav-link" style="display:inline;">Upravit zvíře</a>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- Okno pro adopci -->
<div class="modal fade" id="adoptionModal" tabindex="-1" aria-labelledby="adoptionModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="adoptionModalLabel">Adoptovat zvíře</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-controller="Adoptions" asp-action="Adopt" method="post">
                <div class="modal-body">
                    <input type="hidden" id="animalId" name="animalId" />
                    <div class="mb-3">
                        <label for="amount" class="form-label">Částka, kterou chcete přispívat:</label>
                        <input type="number" class="form-control" id="amount" name="amount" min="1" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Zavřít</button>
                    <button type="submit" class="btn btn-primary-custom">Potvrdit adopci</button>
                </div>
            </form>
        </div>
    </div>
</div>
