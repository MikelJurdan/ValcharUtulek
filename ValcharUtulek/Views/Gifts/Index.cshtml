@model ValcharUtulek.Models.GiftViewModel

@{
    ViewData["Title"] = "Index";
}

<h1>Můžete podpořit náš Útulek</h1>

<div class="row">
    <div class="col-md-6 offset-md-3 mb-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Naplnit misku</h5>
                <form asp-action="Donate" method="post">
                    <div class="form-group">
                        <label asp-for="AnimalId" class="control-label">Vyberte existující zvíře</label>
                        <select asp-for="AnimalId" class="form-control" asp-items="ViewBag.Animals">
                            <option value="">Nové zvíře</option>
                        </select>
                        <span asp-validation-for="AnimalId" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label for="amount" class="form-label">Částka (min. 100 Kč):</label>
                        <input type="number" id="amount" name="Amount" class="form-control" min="100" value="100" required />
                    </div>
                    <button type="submit" class="btn btn-primary-custom">Přispět</button>
                </form>
            </div>
        </div>
    </div>
</div>