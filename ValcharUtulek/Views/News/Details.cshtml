@model ValcharUtulek.Domain.Entities.News

@{
    ViewData["Title"] = "Detail novinky";
}

<h1>@Model.Title</h1>

<div>
    <hr />
    <div class="row">
        <div class="col-md-8">
            <p>@Model.Content</p>
            <p><small class="text-muted">Vytvořeno: @Model.DateAdded.ToShortDateString()</small></p>
        </div>
    </div>
</div>
<div>
    @if (User.IsInRole(ValcharUtulek.Domain.Entities.Role.Admin.ToString()))
    {
        <a asp-action="Edit" asp-route-id="@Model.NewsId">Upravit</a> <span>|</span>
        <a asp-action="Delete" asp-route-id="@Model.NewsId">Smazat</a> <span>|</span>
    }
    <a asp-action="Index">Zpět na seznam</a>
</div>
