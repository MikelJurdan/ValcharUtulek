@model IEnumerable<ValcharUtulek.Domain.Entities.News>

@{
    ViewData["Title"] = "News";
}

@section Styles {
    <link rel="stylesheet" href="~/css/adoptions/index.css" asp-append-version="true" />
}

<h1>Novinky</h1>
@if (User.IsInRole(ValcharUtulek.Domain.Entities.Role.Admin.ToString()))
{
    <p>
        <a asp-action="Create">Create New</a>
    </p>
}
<div class="row">
    @foreach (var news in Model)
    {
        <div class="col-md-3 mb-3">
            <div class="card" style="width: 18rem;">
                <img src="~/images/@(news.Photo ?? "default.png")" class="card-img-top" alt="@news.Title">
                <div class="card-body">
                    <h5 class="card-title">@news.Title</h5>
                    <p class="card-text">
                        @news.Content
                    </p>
                </div>
            </div>
        </div>
    }
</div>